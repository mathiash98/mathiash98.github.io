  const ends = series.map(s=>{ const p=ltvData.filter(d=>d[s.k]!=null&&isFinite(d[s.k])).pop();
    return p ? {y:Y(p[s.k]), n:s.n, c:s.c, v:p[s.k]} : null; }).filter(Boolean).sort((a,b)=>a.y-b.y);
  for(let i=1;i<ends.length;i++) if(ends[i].y - ends[i-1].y < 15) ends[i].y = ends[i-1].y + 15;
  ends.forEach(e=>{
    g += '<text x="'+(W-mr+8)+'" y="'+(e.y-3).toFixed(1)+'" fill="'+e.c+'" font-family="var(--sans)" font-size="11.5" font-weight="600">'+esc(e.n)+'</text>';
