/* ═══ 11b. Maksprisen — modellen snudd på hodet ══════════════════════════
   NOI = 12·leie·(1 − ledighet − driftsandel) − vedlikehold·kjøpesum
   y*  = NOI ÷ totalpris,  totalpris = kjøpesum·(1 + dok.avg.)
   ⇒   kjøpesum = leie · 12(1 − ledighet − driftsandel) ÷ (y*(1 + dok) + vedlikehold) */
let LAST = {th:null};

function kFaktor(yPct){
  if(yPct == null || !isFinite(yPct)) return null;
  const teller = 12 * (1 - S.ledig/100 - S.driftandel/100);
  const nevner = yPct/100 * (1 + (S.dokavg ? 0.025 : 0)) + S.vedl/100;
  if(teller <= 0 || nevner <= 0) return null;
  return teller / nevner;
}
const medianKjop = (() => {
  const m = BOLIGER.map(b => (b[1]/1.025)/b[2]).sort((a,b)=>a-b);
  return m[Math.floor(m.length/2)];
})();
const kFmt = k => k == null ? "—" : nf0.format(Math.round(k)) + " ×";
const spenn = (a, b) => {
  if(a == null || b == null) return '<span class="dash">—</span>';
  if(a >= 1e6 && b >= 1e6) return nf1.format(a/1e6) + "–" + nf1.format(b/1e6) + " mill.";
  return mkr(a) + "–" + mkr(b);
};
const spennKvm = (a, b, m) => (a == null || b == null || !m) ? '<span class="dash">—</span>'
  : nf0.format(Math.round(a/m/1000)) + "–" + nf0.format(Math.round(b/m/1000)) + " k";

function bidOutputs(){
  const th = LAST.th; if(!th) return;
  const kI = kFaktor(th.indeks), kC = kFaktor(th.cf);
  $("kIndeks").textContent  = kFmt(kI);
  $("kCf").textContent      = kFmt(kC);
  $("kFaktisk").textContent = kFmt(medianKjop);
  $("bidNote").innerHTML = kI == null
    ? L("Med disse forutsetningene spiser ledighet og drift hele leien — ingen pris forsvarer seg.",
        "With these assumptions, vacancy and running costs eat the whole rent — no price can be defended.")
    : L("Med " + pct1(S.ledig) + " ledighet, " + pct1(S.driftandel) + " drift og " + pct1(S.vedl)
        + " vedlikehold blir <b>k = " + nf0.format(Math.round(kI)) + "</b> ved terskelen på "
        + pct1(th.indeks) + " — altså <b>" + nf1.format(kI/12) + " ganger årlig bruttoleie</b>.",
        "At " + pct1(S.ledig) + " vacancy, " + pct1(S.driftandel) + " running costs and " + pct1(S.vedl)
        + " maintenance, <b>k = " + nf0.format(Math.round(kI)) + "</b> at the " + pct1(th.indeks)
        + " threshold — that is <b>" + nf1.format(kI/12) + " times the annual gross rent</b>.");

  SOV.forEach((r,i) => {
    const [lav, hoy, m2] = r;
    const el = id => $("bid-"+i+"-"+id);
    if(!el("mi")) return;
    el("mi").innerHTML  = spenn(kI && lav*kI, kI && hoy*kI);
    el("ki").innerHTML  = spennKvm(kI && lav*kI, kI && hoy*kI, m2);
    el("mc").innerHTML  = spenn(kC && lav*kC, kC && hoy*kC);
    el("kc").innerHTML  = spennKvm(kC && lav*kC, kC && hoy*kC, m2);
  });
}

function drawBidTable(){
  const navn = LANG === "en" ? ["1 bedroom","2 bedrooms","3 bedrooms","4 bedrooms"]
                             : ["1 soverom","2 soverom","3 soverom","4 soverom"];
  const inp = (i,c,v,st) => '<input type="number" data-r="'+i+'" data-c="'+c+'" value="'+v+'" step="'+st+'" min="0">';
  let h = '<table class="bid"><thead><tr>'
    + (LANG === 'en' ? ['Bedrooms','Rent from','Rent to','m²','Max · beat index','kr/m²','Max · break-even','kr/m²']
                     : ['Soverom','Leie fra','Leie til','m²','Maks · slå indeks','kr/m²','Maks · null kontantstrøm','kr/m²'])
        .map(t=>'<th>'+t+'</th>').join("") + '</tr></thead><tbody>';
  SOV.forEach((r,i) => {
    h += '<tr><td class="sov">'+navn[i]+'</td>'
      + '<td>'+inp(i,0,r[0],500)+'</td><td>'+inp(i,1,r[1],500)+'</td><td>'+inp(i,2,r[2],1)+'</td>'
      + '<td class="out" id="bid-'+i+'-mi"></td><td class="out" id="bid-'+i+'-ki"></td>'
      + '<td class="out" id="bid-'+i+'-mc"></td><td class="out" id="bid-'+i+'-kc"></td></tr>';
  });
  $("tblBid").innerHTML = h + '</tbody></table>';
  bidOutputs();
}

function drawBidChart(){
  const th = LAST.th; if(!th) return;
  const W=900, H=430, ml=74, mr=150, mt=76, mb=44;
  const xmin=8000, xmax=45000;
  const X = v => ml + (v-xmin)/(xmax-xmin)*(W-ml-mr);

  const dok = S.dokavg ? 1.025 : 1;
  const alle = BOLIGER.map(b => ({n:b[0], leie:b[2], pris:b[1]/dok, y:boligYield(b)}));
  const dots = alle.filter(d => d.leie >= xmin && d.leie <= xmax);
  const utelatt = alle.length - dots.length;

  const linjer = [
    {k:kFaktor(th.indeks), c:"var(--s1)", n:L("Slå indeksfondet","Beat the index fund")},
    {k:kFaktor(th.cf),     c:"var(--s2)", n:L("Null kontantstrøm","Break-even cash flow")},
    {k:kFaktor(th.rente),  c:"var(--s3)", n:L("Dekke renten","Cover the interest")}
  ];
  const dotMax = dots.length ? Math.max(...dots.map(d=>d.pris)) : 5e6;
  const kC = linjer[1].k || 100;
  let hi = Math.max(dotMax*1.12, kC*xmax*1.35);
  const kAlle = linjer.map(l=>l.k).filter(Boolean);
  if(kAlle.length) hi = Math.min(hi, Math.max(...kAlle)*xmax*1.05);
  const Y = v => mt + (1-v/hi)*(H-mt-mb);

  let g = '<defs><clipPath id="bidClip"><rect x="'+ml+'" y="'+mt+'" width="'+(W-ml-mr)+'" height="'+(H-mt-mb)+'"/></clipPath></defs>';
  niceTicks(0,hi,5).forEach(v=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
    g += '<text x="'+(ml-10)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+mkr(v)+'</text>';
  });
  [10000,20000,30000,40000].forEach(v=>{
    g += '<text x="'+X(v).toFixed(1)+'" y="'+(H-mb+20)+'" text-anchor="middle" '+AX+'>'+nf0.format(v/1000)+' k</text>';
  });
  g += '<text x="'+((ml+W-mr)/2)+'" y="'+(H-4)+'" text-anchor="middle" '+AXL+'>'+L('Månedsleie','Monthly rent')+'</text>';
  g += '<text transform="translate(15,'+((mt+H-mb)/2)+') rotate(-90)" text-anchor="middle" '+AXL+'>'+L('Maks kjøpesum','Maximum price')+'</text>';

  // soveromsbånd som egne rader over grafen, så overlappende leienivåer ikke kolliderer
  const navn = LANG === "en" ? ["1 bed","2 bed","3 bed","4 bed"] : ["1 sov","2 sov","3 sov","4 sov"];
  SOV.forEach((r,i)=>{
    const y = 14 + i*14, x0 = X(Math.max(xmin,r[0])), x1 = X(Math.min(xmax,r[1]));
    if(x1 <= x0) return;
    g += '<rect x="'+x0.toFixed(1)+'" y="'+y+'" width="'+(x1-x0).toFixed(1)+'" height="6" rx="3" fill="var(--ink-3)" opacity=".38"/>';
    g += '<text x="'+(x1+8).toFixed(1)+'" y="'+(y+6)+'" '+AX+'>'+navn[i]+'</text>';
  });

  g += '<g clip-path="url(#bidClip)">';
  linjer.forEach(l=>{
    if(!l.k) return;
    g += '<line x1="'+X(xmin).toFixed(1)+'" y1="'+Y(xmin*l.k).toFixed(1)+'" x2="'+X(xmax).toFixed(1)+'" y2="'+Y(xmax*l.k).toFixed(1)
      + '" stroke="'+l.c+'" stroke-width="2" stroke-linecap="round"/>';
  });
  const cut = th.indeks == null ? -1e9 : th.indeks;
  dots.forEach(d=>{
    d.px = X(d.leie); d.py = Y(d.pris); d.ok = d.y >= cut;
    g += '<circle cx="'+d.px.toFixed(1)+'" cy="'+d.py.toFixed(1)+'" r="5" fill="'+(d.ok?"var(--good)":"var(--crit)")
      + '" fill-opacity=".85" stroke="var(--surface)" stroke-width="2"/>';
  });
  g += '</g>';

  const ends = linjer.filter(l=>l.k).map(l=>({y:Math.max(mt+6, Math.min(H-mb, Y(xmax*l.k))), n:l.n, c:l.c, k:l.k}))
    .sort((a,b)=>a.y-b.y);
  for(let i=1;i<ends.length;i++) if(ends[i].y-ends[i-1].y<26) ends[i].y = ends[i-1].y+26;
  ends.forEach(e=>{
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y-3).toFixed(1)+'" fill="'+e.c+'" font-family="var(--sans)" font-size="11.5" font-weight="600">'+esc(e.n)+'</text>';
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y+10).toFixed(1)+'" '+AX+'>'+nf0.format(Math.round(e.k))+L(' × leien',' × rent')+'</text>';
  });
  g += '<g id="bidCross" opacity="0"><line y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--ink-3)" stroke-width="1"/></g>';

  const svg = setSvg("plotBid","tipBid",g,W,H);
  const plot = $("plotBid"), tip = $("tipBid"), cg = svg.querySelector("#bidCross"), cl = cg.querySelector("line");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), k = r.width/W;
    const sx = (ev.clientX-r.left)/k, sy = (ev.clientY-r.top)/k;
    let best=null, bd=1e9;
    dots.forEach(d=>{ const q=(d.px-sx)**2+(d.py-sy)**2; if(q<bd){bd=q;best=d;} });
    if(best && bd <= 22*22){
      cg.setAttribute("opacity",0);
      const kI = linjer[0].k, maks = kI ? best.leie*kI : null;
      place(tip, plot, svg, W, best.px, best.py,
        '<div class="t">'+esc(best.n)+'</div>'
        + tipRow(L("Betalt","Paid"), kr(best.pris), best.ok?"var(--good)":"var(--crit)")
        + tipRow(L("Leie","Rent"), kr(best.leie)+L("/mnd","/mo"))
        + tipRow(L("Maks · slå indeks","Max · beat index"), maks==null?"—":kr(maks), "var(--s1)")
        + tipRow(L("Netto yield","Net yield"), pct2(best.y)));
      return;
    }
    if(sx<ml-6 || sx>W-mr+6){ hide(tip); cg.setAttribute("opacity",0); return; }
    const leie = Math.round((xmin + (sx-ml)/(W-ml-mr)*(xmax-xmin))/500)*500;
    cg.setAttribute("opacity",1); cl.setAttribute("x1",X(leie)); cl.setAttribute("x2",X(leie));
    place(tip, plot, svg, W, X(leie), mt+8,
      '<div class="t">'+L('Leie ','Rent ')+kr(leie)+L('/mnd','/mo')+'</div>'
      + linjer.map(l=>tipRow(l.n, l.k?kr(leie*l.k):"—", l.c)).join(""));
  };
  plot.onpointerleave = () => { hide(tip); cg.setAttribute("opacity",0); };

  $("legBid").innerHTML =
      linjer.map(l=>'<span class="item"><span class="swatch" style="background:'+l.c+'"></span>'+esc(l.n)+'</span>').join("")
    + '<span class="item"><span class="dot" style="background:var(--good)"></span><span class="sym">✓</span> '+L('Bolig over terskelen','Flat above the threshold')+'</span>'
    + '<span class="item"><span class="dot" style="background:var(--crit)"></span><span class="sym">✕</span> '+L('Bolig under','Flat below')+'</span>';
  $("bidChartNote").textContent = L("Linjene bruker ","The lines use ") + pct1(S.driftandel)
    + L(" drift av leien"," running costs of rent")
    + (utelatt ? " · " + utelatt + L(" boliger med leie utenfor skalaen er utelatt"," flats with rent outside the scale are omitted") : "");
  $("tblBidChart").innerHTML = tableHtml(
    [L("Månedsleie","Monthly rent"),L("Slå indeksfondet","Beat the index fund"),L("Null kontantstrøm","Break-even cash flow"),L("Dekke renten","Cover the interest")],
    [10000,15000,20000,25000,30000,35000,40000,45000].map(v =>
      [kr(v)].concat(linjer.map(l => l.k ? kr(v*l.k) : "—"))));
}


/* ═══ 13. Finn.no-import ══════════════════════════════════════════════════
   Finn sender ikke CORS-headere, så en lenke må hentes via en lese-proxy.
   Limt inn annonsetekst parses direkte og virker alltid. */

const FINN_PROXY = "https://r.jina.ai/";

function fTall(t, ...labels){
  for(const lab of labels){
    let m = t.match(new RegExp(lab + "[^0-9]{0,40}([0-9][0-9 \u00a0\u202f]*)", "i"));
    if(!m) m = t.match(new RegExp("([0-9][0-9 \u00a0\u202f]*)[^0-9A-Za-zÆØÅæøå]{0,4}" + lab, "i"));
    if(m){
      const n = parseInt(m[1].replace(/[^0-9]/g, ""), 10);
      if(isFinite(n)) return n;
    }
  }
  return null;
}

function parseFinn(t){
  t = t.replace(/\u00a0|\u202f/g, " ");
  const eie = /Eieform[^A-Za-zÆØÅæøå]{0,20}(Eier\s*\(Selveier\)|Selveier|Eier|Andel|Aksje|Obligasjon)/i.exec(t);
  const eieform = eie ? eie[1].trim() : null;
  return {
    pris:       fTall(t, "Prisantydning", "Prisantydn"),
    totalpris:  fTall(t, "Totalpris"),
    omkostning: fTall(t, "Omkostninger"),
    felles:     fTall(t, "Felleskost(?:nader)?(?:\\/mnd)?", "Felleskostnader per m"),
    kommunale:  fTall(t, "Kommunale avg\\.?(?:ifter)?"),
    fellesgjeld:fTall(t, "Fellesgjeld"),
    soverom:    fTall(t, "Soverom"),
    areal:      fTall(t, "Internt bruksareal", "Primærrom", "P-rom", "Bruksareal", "BRA"),
    eieform
  };
}

function anvendFinn(d){
  const res = $("finnRes"), rows = [];
  let endret = 0;

  if(d.pris){ S.pris = Math.round(d.pris/10000)*10000; S.opp = 0; endret++;
    rows.push([L("Prisantydning","Asking price"), kr(d.pris)]); }
  else if(d.totalpris && d.omkostning){
    S.pris = Math.round((d.totalpris-d.omkostning)/10000)*10000; endret++;
    rows.push([L("Pris (totalpris − omk.)","Price (total − costs)"), kr(S.pris)]); }

  if(d.eieform){
    const selveier = /selveier|^eier$/i.test(d.eieform);
    S.dokavg = selveier; endret++;
    rows.push([L("Eieform","Ownership"), d.eieform + (selveier ? L(" · 2,5 % dok."," · 2.5 % duty") : L(" · ingen dok."," · no duty"))]);
  }

  const felles = d.felles || 0, komm = d.kommunale || 0;
  if(felles || komm){
    S.drift = Math.round(felles + komm/12); endret++;
    rows.push([L("Driftskostnad","Running costs"), kr(S.drift) + L("/mnd","/mo")]);
    if(felles) rows.push([L("  felleskost","  shared costs"), kr(felles) + L("/mnd","/mo")]);
    if(komm)   rows.push([L("  kommunale","  municipal"), kr(komm) + L("/år","/yr")]);
  }

  let leieGjett = null;
  if(d.soverom){
    const i = Math.min(Math.max(d.soverom, 1), SOV.length) - 1;
    leieGjett = Math.round((SOV[i][0] + SOV[i][1]) / 2 / 500) * 500;
    S.leie = leieGjett; endret++;
    rows.push([d.soverom + L(" soverom"," bedrooms"), L("leie gjettet til ","rent estimated at ") + kr(leieGjett) + L("/mnd","/mo")]);
  }
  if(d.areal && S.pris) rows.push([L("Areal","Area"), d.areal + " m² · " + kr(S.pris/d.areal) + "/m²"]);
  if(d.fellesgjeld) rows.push([L("Fellesgjeld","Shared debt"), kr(d.fellesgjeld) + L(" — ikke med i modellen"," — not in the model")]);

  if(!endret){
    res.hidden = false;
    res.innerHTML = '<div class="msg warn">'+L("Fant ingen tall å bruke. Er hele annonsen kopiert med?","Found no usable numbers. Was the whole listing copied?")+'</div>';
    return;
  }
  picked = -1; $("pick").value = "-1";
  $("pickHint").textContent = L("Hentet fra Finn-annonsen.","Taken from the Finn listing.");
  res.hidden = false;
  res.innerHTML = rows.map(([k, v]) =>
      '<div class="r"><span>' + esc(k) + '</span><b>' + esc(v) + '</b></div>').join("")
    + '<div class="msg' + (leieGjett ? ' warn' : ' ok') + '">'
    + (leieGjett ? L("Leien er et anslag fra soveromstabellen — sjekk mot faktiske leiepriser i området.",
                     "The rent is an estimate from the bedroom table — check it against real local rents.")
                 : L("Fant ikke antall soverom, så leien står urørt.",
                     "No bedroom count found, so the rent was left alone."))
    + '</div>';
  schedule();
}

async function importerFinn(){
  const inn = $("finnInn").value.trim(), res = $("finnRes"), btn = $("finnGo");
  if(!inn){
    res.hidden = false;
    res.innerHTML = '<div class="msg warn">'+L("Lim inn en finn.no-lenke eller teksten fra annonsen først.","Paste a finn.no link or the listing text first.")+'</div>';
    return;
  }
  const erLenke = /^https?:\/\/\S+$/i.test(inn);
  if(!erLenke) return anvendFinn(parseFinn(inn));

  if(!/finn\.no/i.test(inn)){
    res.hidden = false;
    res.innerHTML = '<div class="msg warn">'+L("Det ser ut som en lenke, men ikke til finn.no.","That looks like a link, but not to finn.no.")+'</div>';
    return;
  }
  btn.setAttribute("aria-busy", "true");
  btn.textContent = L("Henter …","Fetching …");
  res.hidden = false;
  res.innerHTML = '<div class="msg">'+L("Henter annonsen …","Fetching the listing …")+'</div>';
  try{
    const r = await fetch(FINN_PROXY + inn, { headers: { Accept: "text/plain" } });
    if(!r.ok) throw new Error("status " + r.status);
    const txt = await r.text();
    if(txt.length < 200) throw new Error("tomt svar");
    anvendFinn(parseFinn(txt));
  }catch(e){
    res.hidden = false;
    res.innerHTML = '<div class="msg warn">' + L("Fikk ikke hentet annonsen automatisk — Finn blokkerer direkte oppslag fra nettleseren.",
        "Could not fetch the listing automatically — Finn blocks direct lookups from the browser.") + '</div>'
      + '<div class="msg">' + L("Åpne annonsen, merk alt med ⌘A, kopier med ⌘C og lim inn teksten her i stedet. Det virker alltid.",
        "Open the listing, select all with ⌘A, copy with ⌘C and paste the text here instead. That always works.") + '</div>';
  }finally{
    btn.removeAttribute("aria-busy");
    btn.textContent = L("Fyll ut fra annonsen","Fill in from listing");
  }
}

/* ═══ 12. Oppstart ═══════════════════════════════════════════════════════ */
(function init(){
  $("pris").step = 10000;

  // boligvelger
  const sel = $("pick");
  sel.innerHTML = '<option value="-1">' + L('Medianboligen i utvalget','The median flat of the sample') + '</option>'
    + BOLIGER.map((b,i)=>'<option value="'+i+'">'+esc(b[0])+'</option>').join("");
  sel.onchange = () => {
    picked = parseInt(sel.value,10);
    if(picked < 0){
      Object.assign(S, {pris:DEFAULTS.pris, opp:DEFAULTS.opp, leie:DEFAULTS.leie, drift:DEFAULTS.drift});
      $("pickHint").textContent = L("Medianboligen av de 62.","The median flat of the 62.");
    } else {
      const b = BOLIGER[picked];
      S.pris  = Math.round(b[1] / (S.dokavg ? 1.025 : 1) / 10000) * 10000;
      S.opp   = 0;
      S.leie  = b[2];
      S.drift = b[3];
      $("pickHint").textContent = L("Totalpris ","Total price ") + kr(b[1]) + L(" · oppussing er lagt inn i kjøpesummen."," · renovation is folded into the price.");
    }
    schedule();
  };

  koblTallfelt();
  RANGES.forEach(k => $(k).addEventListener("input", e => {
    S[k] = parseFloat(e.target.value);
    if(picked >= 0 && ["pris","opp","leie","drift"].includes(k)){ picked=-1; sel.value="-1"; }
    schedule();
  }));
  TOGGLES.forEach(k => $(k).addEventListener("change", e => { S[k] = e.target.checked; schedule(); }));
  document.querySelectorAll(".chip[data-rente]").forEach(c =>
    c.addEventListener("click", () => { S.rente = parseFloat(c.dataset.rente); schedule(); }));
  document.querySelectorAll(".chip[data-ek]").forEach(c =>
    c.addEventListener("click", () => { S.ektot = ekChip(c); schedule(); }));
  // knappen bygges på nytt hver render, så lytteren må ligge på feltet
  $("ektotField").addEventListener("click", e => {
    if(e.target.id !== "ektotFix") return;
    const i = kapitalOppsett();
    S.ltv = Math.min(parseFloat($("ltv").max), Math.ceil(i.ltvMin));
    schedule();
  });
  $("reset").addEventListener("click", () => {
    S = Object.assign({}, DEFAULTS);
    SOV = SOV_DEFAULT.map(r => r.slice());
    picked = -1; sel.value = "-1";
    $("pickHint").textContent = L("Medianboligen av de 62.","The median flat of the 62."); schedule();
  });

  $("finnGo").addEventListener("click", importerFinn);
  $("finnClear").addEventListener("click", () => {
    $("finnInn").value = ""; $("finnRes").hidden = true;
  });
  $("finnInn").addEventListener("keydown", e => {
    if((e.metaKey || e.ctrlKey) && e.key === "Enter"){ e.preventDefault(); importerFinn(); }
  });

  // boblene står fast mot vinduet, så de må vekk når noe ruller under dem
  document.addEventListener("scroll", () => {
    document.querySelectorAll(".tip").forEach(t => { t.style.opacity = 0; });
  }, {capture:true, passive:true});

  // skuff på smale skjermer
  const rail = $("rail"), scrim = $("scrim"), fab = $("fab");
  function setDrawer(open){
    rail.classList.toggle("open", open);
    scrim.classList.toggle("on", open);
    document.body.classList.toggle("locked", open);
    fab.setAttribute("aria-expanded", open ? "true" : "false");
    if(open){ const f = rail.querySelector("select, summary"); if(f) f.focus({preventScroll:true}); }
    else fab.focus({preventScroll:true});
  }
  fab.addEventListener("click", () => setDrawer(!rail.classList.contains("open")));
  scrim.addEventListener("click", () => setDrawer(false));
  $("railClose").addEventListener("click", () => setDrawer(false));
  document.addEventListener("keydown", e => { if(e.key === "Escape" && rail.classList.contains("open")) setDrawer(false); });
  window.addEventListener("resize", () => { if(window.innerWidth > 1080 && rail.classList.contains("open")) setDrawer(false); });

  // redigerbar soveromstabell — oppdaterer utdata og graf uten å bygge tabellen på nytt
  $("tblBid").addEventListener("input", e => {
    const el = e.target;
    if(el.tagName !== "INPUT") return;
    const r = +el.dataset.r, c = +el.dataset.c, v = parseFloat(el.value);
    if(!isFinite(v) || v < 0) return;
    SOV[r][c] = v;
    bidOutputs(); drawBidChart(); writeUrl();
  });

  // del gjeldende oppsett
  $("share").addEventListener("click", async () => {
    writeUrl();
    const btn = $("share"), before = btn.textContent;
    try{ await navigator.clipboard.writeText(location.href); btn.textContent = L("✓ Lenke kopiert","✓ Link copied"); }
    catch(e){ btn.textContent = L("Kopier fra adressefeltet","Copy from the address bar"); }
    setTimeout(() => { btn.textContent = before; }, 2200);
  });

  document.querySelectorAll("[data-lang]").forEach(b =>
    b.addEventListener("click", () => {
      if(b.dataset.lang === LANG) return;
      LANG = b.dataset.lang;
      setLocale();
      applyLang();
      render();
    }));

  readUrl();
  applyLang();
  if(picked >= 0){
    sel.value = String(picked);
    $("pickHint").textContent = L("Totalpris ","Total price ") + kr(BOLIGER[picked][1]) + L(" · oppussing er lagt inn i kjøpesummen."," · renovation is folded into the price.");
  }

  render();
})();
