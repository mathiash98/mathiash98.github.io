  // markør for valgt belåningsgrad
  g += '<line x1="'+X(S.ltv).toFixed(1)+'" x2="'+X(S.ltv).toFixed(1)+'" y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--accent)" stroke-width="1.5" opacity=".35"/>';

  const series = [
