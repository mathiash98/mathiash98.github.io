    const last = pts[pts.length-1];
    g += '<circle cx="'+X(last.b).toFixed(1)+'" cy="'+Y(last[s.k]).toFixed(1)+'" r="4" fill="'+s.c+'" stroke="var(--surface)" stroke-width="2"/>';
  });
