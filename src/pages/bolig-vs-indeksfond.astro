/* ═══ 2. Formatering ═════════════════════════════════════════════════════ */
let nf0, nf1, nf2;
function setLocale(){
  const loc = LANG === "en" ? "en-GB" : "nb-NO";
  nf0 = new Intl.NumberFormat(loc,{maximumFractionDigits:0});
