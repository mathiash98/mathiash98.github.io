setLocale();
const kr   = v => nf0.format(Math.round(v)) + " kr";
const krS  = v => (v<0?"−":"") + nf0.format(Math.abs(Math.round(v))) + " kr";
const pct1 = v => nf1.format(v).replace("-","−") + " %";
const pct2 = v => nf2.format(v).replace("-","−") + " %";
const ppS  = v => (v>0?"+":v<0?"−":"") + nf1.format(Math.abs(v)) + " pp";
const mkr  = v => { const a=Math.abs(v);
  if(a>=1e6) return (v<0?"−":"")+nf1.format(a/1e6)+L(" mill."," m");
  if(a>=1e3) return (v<0?"−":"")+nf0.format(a/1e3)+" k";
  return krS(v); };

/* ═══ 3. Tilstand ════════════════════════════════════════════════════════ */
const DEFAULTS = {
  pris:3400000, opp:0, leie:19000, drift:3200, ledig:8, vedl:0.7, dokavg:true,
  ltv:80, rente:5.0, lopetid:25, avdragsfri:false, restfond:false, ektot:2000000,
  vekstbolig:3.5, indeks:7.0, kpi:2.5, horisont:15, salgsomk:2.5,
  skatt:true, formue:false, formuesats:1.0, driftandel:17
};
/* soveromsbånd: [leie fra, leie til, areal m²] */
const SOV_DEFAULT = [[17000,22000,45],[18000,22000,62],[26000,30000,85],[32000,38000,108]];
let SOV = SOV_DEFAULT.map(r => r.slice());
let S = Object.assign({}, DEFAULTS);

const T_LEIE = 0.22, T_GEV_BOLIG = 0.22, T_GEV_FOND = 0.3784, SKJERMING = 0.030;

/* ═══ 4. Motoren ═════════════════════════════════════════════════════════
   Én simulering, år for år. Boligsporet og fondssporet får nøyaktig samme
   kontantinnskudd til samme tid, så terminalformuen er direkte sammenlignbar. */

function annuitet(r, n, pv){ return r === 0 ? pv/n : pv*r/(1-Math.pow(1+r,-n)); }

function simuler(o){
  const p = Object.assign({}, S, o||{});
  const V0    = p.pris + p.opp;                                  // markedsverdi ved kjøp
  const kost  = p.pris * (1 + (p.dokavg ? 0.025 : 0)) + p.opp;   // totalpris / kostpris
  const laan0 = Math.min(p.ltv/100 * V0, kost);
  const EK    = kost - laan0;                                    // bundet i boligen
  // Med «resterende egenkapital i fond» er beløpet du stiller med låst: det som ikke
  // går inn som egenkapital står i indeksfond fra dag én, og fondssporet får nøyaktig
  // den samme totalkapitalen. Rekker beløpet ikke til egenkapitalen, faller vi tilbake
  // til EK — da er sammenligningen fortsatt krone mot krone.
  const KAP   = p.restfond ? Math.max(p.ektot, EK) : EK;
  const rest  = KAP - EK;
  const r     = p.rente/100, g = p.vekstbolig/100, R = p.indeks/100;
  const kpi   = p.kpi/100, v = p.ledig/100, N = Math.round(p.horisont);
  const fs    = p.formue ? p.formuesats/100 : 0;
  const sk    = p.skatt;
  const ann   = p.avdragsfri ? 0 : annuitet(r, p.lopetid, laan0);

  let gjeld = laan0, side = rest, sideBasis = rest, sideSkjerm = 0;
  let fond = KAP, fondBasis = KAP, fondSkjerm = 0;

  const aar = [];
  for(let t=1; t<=N; t++){
    const V     = V0 * Math.pow(1+g, t);
    const Vfor  = V0 * Math.pow(1+g, t-1);
    const infl  = Math.pow(1+kpi, t-1);
    const leie  = p.leie*12 * infl * (1-v);
    const drift = p.drift*12 * infl + p.vedl/100 * Vfor;
    const rente = r * gjeld;
    const avdr  = p.avdragsfri ? 0 : Math.max(0, Math.min(gjeld, ann - rente));
    const skattLeie = sk ? T_LEIE * (leie - drift - rente) : 0;

    // formuesskatt: sekundærbolig 100 % av verdi, aksjefond 80 %
    const fBolig = fs * Math.max(0, V - gjeld + 0.8*side);
    const fFond  = fs * Math.max(0, 0.8 * fond);

    const cf = leie - drift - rente - avdr - skattLeie - fBolig;
    gjeld -= avdr;

    // sidefond: boligens overskudd plasseres i indeksfond
    sideSkjerm += SKJERMING * sideBasis;
    side = side * (1+R);
    if(cf > 0){ side += cf; sideBasis += cf; }
    const innskudd = cf < 0 ? -cf : 0;

    // fondssporet: samme innskudd, samme tidspunkt
    fondSkjerm += SKJERMING * fondBasis;
    fond = fond * (1+R) - fFond + innskudd;
    fondBasis += innskudd;

    // hva sitter du igjen med hvis du selger i år t
    const netto  = V * (1 - p.salgsomk/100);
    const gevB   = sk ? T_GEV_BOLIG * Math.max(0, netto - kost) : 0;
    const gevS   = sk ? T_GEV_FOND  * Math.max(0, side - sideBasis - sideSkjerm) : 0;
    const gevF   = sk ? T_GEV_FOND  * Math.max(0, fond - fondBasis - fondSkjerm) : 0;

    aar.push({
      t, V, gjeld, leie, drift, rente, avdr, skattLeie, fBolig, cf, innskudd,
      bolig: netto - gevB - gjeld + side - gevS,
      fondNetto: fond - gevF,
      innskuttSum: 0
    });
  }
  // kumulativt innskutt
  let sum = KAP;
  aar.forEach(a => { sum += a.innskudd; a.innskuttSum = sum; });

  const sisteAar = aar[aar.length-1] || null;
  const noi1 = p.leie*12*(1-v) - (p.drift*12 + p.vedl/100 * V0);
  return {
    p, V0, kost, laan0, EK, KAP, rest, ann, aar, siste: sisteAar,
    nettoYield: kost > 0 ? noi1/kost*100 : 0,
    bruttoYield: kost > 0 ? p.leie*12/kost*100 : 0,
    noi1
  };
}

/* Nødvendig leie for at et mål skal treffes — monoton, så halvering funker. */
function losLeie(fn, o){
  let lo = 0, hi = 400000;
  if(fn(hi, o) < 0) return null;
  if(fn(lo, o) > 0) { // klarer målet uten leie i det hele tatt
    lo = -400000;
    if(fn(lo, o) > 0) return lo;
  }
  for(let i=0;i<60;i++){ const m=(lo+hi)/2; if(fn(m,o) > 0) hi=m; else lo=m; }
  return (lo+hi)/2;
}
const yieldAvLeie = (leie, o) => {
  const p = Object.assign({}, S, o||{});
  const V0 = p.pris + p.opp, kost = p.pris*(1+(p.dokavg?0.025:0)) + p.opp;
  return kost>0 ? (leie*12*(1-p.ledig/100) - p.drift*12 - p.vedl/100*V0)/kost*100 : 0;
};

/* De tre tersklene, uttrykt som netto yield i prosent */
function terskler(o){
  const slaaIndeks = losLeie((leie,oo)=>{ const s=simuler(Object.assign({leie},oo));
    return s.siste ? s.siste.bolig - s.siste.fondNetto : 0; }, o);
  const nullCf = losLeie((leie,oo)=>{ const s=simuler(Object.assign({leie},oo));
    return s.aar[0] ? s.aar[0].cf : 0; }, o);
  const dekkRente = losLeie((leie,oo)=>{ const s=simuler(Object.assign({leie},oo));
    const a=s.aar[0]; return a ? a.leie - a.drift - a.rente : 0; }, o);
  return {
    indeks: slaaIndeks===null?null:yieldAvLeie(slaaIndeks,o),
    cf:     nullCf===null?null:yieldAvLeie(nullCf,o),
    rente:  dekkRente===null?null:yieldAvLeie(dekkRente,o)
  };
}

/* Alternativet til å kjøpe er å la være. Da står hele beløpet i indeksfondet
   hele eiertiden, uten innskudd underveis — og det tallet avhenger ikke av
   belåningsgraden i det hele tatt. Samme regnestykke som fondssporet i motoren. */
function fondAlene(K, N){
  const R = S.indeks/100, fs = S.formue ? S.formuesats/100 : 0;
  let fond = K, skjerm = 0;
  for(let t=1; t<=N; t++){
    skjerm += SKJERMING * K;
    fond = fond*(1+R) - fs * Math.max(0, 0.8*fond);
  }
  const gev = S.skatt ? T_GEV_FOND * Math.max(0, fond - K - skjerm) : 0;
  return fond - gev;
}

/* Årlig avkastning på pengene du faktisk har stilt med. Boligsporet får ikke
   bare kapitalen ved start, men også det du fyller på underveis — da er
   (formue/kapital)^(1/N) feil mål, for de kronene har ikke ligget der like
   lenge. Renten som nuller kontantstrømmen har det. */
function internrente(kapital, innskudd, sluttverdi, N){
  if(!(kapital > 0) || !(sluttverdi > 0) || N < 1) return null;
  const npv = r => {
    let v = -kapital;
    for(let t=1; t<=N; t++) v -= (innskudd[t-1] || 0)/Math.pow(1+r, t);
    return v + sluttverdi/Math.pow(1+r, N);
  };
  let lo = -0.95, hi = 3;
  if(npv(lo) <= 0 || npv(hi) >= 0) return null;
  for(let i=0; i<80; i++){ const m = (lo+hi)/2; if(npv(m) > 0) lo = m; else hi = m; }
  return (lo+hi)/2*100;
}

/* Fast egenkapital: hva boligen krever, hva som blir til overs, og den laveste
   belåningsgraden beløpet i det hele tatt rekker til. */
function kapitalOppsett(o){
  const p  = Object.assign({}, S, o||{});
  const V0 = p.pris + p.opp;
  const kost = p.pris*(1+(p.dokavg?0.025:0)) + p.opp;
  const EK = kost - Math.min(p.ltv/100*V0, kost);
  return {
    paa: !!p.restfond, K: p.ektot, kost, V0, EK,
    rest: Math.max(0, p.ektot - EK),
    mangler: Math.max(0, EK - p.ektot),
    ltvMin: V0 > 0 ? Math.max(0, Math.min(100, (kost - p.ektot)/V0*100)) : 0
  };
}

/* Netto yield for en bolig fra arket, med gjeldende ledighet og vedlikehold */
function boligYield(b){
  const [ , tot, leie, drift ] = b;
  const V0 = tot / (S.dokavg ? 1.025 : 1);           // tilnærmet markedsverdi
  return (leie*12*(1-S.ledig/100) - drift*12 - S.vedl/100*V0) / tot * 100;
}
</script>

<script is:inline>
"use strict";
/* ═══ 5. Tegneverktøy ════════════════════════════════════════════════════ */
const esc = s => String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
const AX = 'fill="var(--ink-3)" font-family="var(--mono)" font-size="11"';
const AXL= 'fill="var(--ink-2)" font-family="var(--sans)" font-size="11.5"';

function setSvg(plotId, tipId, inner, w, h){
  const el = document.getElementById(plotId), tip = document.getElementById(tipId);
  el.innerHTML = '<svg viewBox="0 0 '+w+' '+h+'" role="img">'+inner+'</svg>';
  // boblen flyttes ut av kortet én gang, så ingen overflow:hidden kan klippe den
  if(tip && tip.parentElement !== document.body) document.body.appendChild(tip);
  return el.querySelector("svg");
}
/* plot-argumentet er ikke lenger i bruk — boblen måles mot vinduet. */
function place(tip, plot, svg, vbW, x, y, text){
  const r = svg.getBoundingClientRect(), k = r.width/vbW;
  tip.innerHTML = text;
  tip.style.opacity = 1;
  const tw = tip.offsetWidth, th = tip.offsetHeight;
  const ax = r.left + x*k, ay = r.top + y*k;
  // vannrett: hele boblen skal være innenfor vinduet
  const px = Math.max(tw/2 + 8, Math.min(window.innerWidth - tw/2 - 8, ax));
  // loddrett: over punktet, men snudd under når det ikke er plass over
  const py = (ay - 10 - th < 8) ? ay + 18 + th : ay - 10;
  tip.style.left = px.toFixed(1) + "px";
  tip.style.top  = py.toFixed(1) + "px";
}
const hide = tip => { tip.style.opacity = 0; };
function tipRow(k, v, color){
  return '<div class="r"><span class="k">'+(color?'<span style="width:9px;height:3px;border-radius:9px;background:'+color+';display:inline-block"></span>':'')+esc(k)+'</span><b>'+v+'</b></div>';
}
function niceTicks(min, max, n){
  const span = max-min || 1, raw = span/n, mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const step = [1,2,2.5,5,10].map(m=>m*mag).find(v=>v>=raw) || 10*mag;
  const out=[]; for(let v=Math.ceil(min/step)*step; v<=max+1e-9; v+=step) out.push(+v.toFixed(10));
  return out;
}
function tableHtml(head, rows){
  return '<table><thead><tr>'+head.map(h=>'<th>'+esc(h)+'</th>').join("")+'</tr></thead><tbody>'
    + rows.map(r=>'<tr>'+r.map(c=>'<td>'+c+'</td>').join("")+'</tr>').join("") + '</tbody></table>';
}

/* ═══ 6. Graf 1 — terskler mot belåningsgrad ═════════════════════════════ */
let ltvData = [];
function drawLtv(){
