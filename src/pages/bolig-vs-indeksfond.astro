/* ═══ 6b. Graf 1b — formue mot belåningsgrad med fast egenkapital ════════
   Dilemmaet: du har et beløp, og skal velge mellom å binde det i boligen eller
   la det stå i indeksfond. Her har begge sporene nøyaktig samme totalkapital
   ved hver eneste belåningsgrad, så kronene kan sammenlignes langs hele aksen. */
let kapData = [];
function drawKapital(){
  const sec = document.getElementById("kapSection");
  if(!sec) return;
  sec.hidden = !S.restfond;
  if(!S.restfond) return;

  const info = kapitalOppsett();
  const K = S.ektot, N = Math.round(S.horisont);
  const xs = []; for(let b=0; b<=90; b++) xs.push(b);
  const uten = fondAlene(K, N);                 // kjøper ikke bolig
  const utenAvk = internrente(K, [], uten, N);  // og hva det gir per år
  kapData = xs.map(b => {
    const sim = simuler({ltv:b}), a = sim.siste;
    const avk = a ? internrente(K, sim.aar.map(x => x.innskudd), a.bolig, N) : null;
    return {b, mulig: sim.EK <= K + 0.5, ek: sim.EK, rest: Math.max(0, K - sim.EK),
            bolig: a ? a.bolig : 0, fond: uten,
            innskutt: a ? Math.max(0, a.innskuttSum - sim.KAP) : 0,
            avk, mer: (avk == null || utenAvk == null) ? null : avk - utenAvk};
  });
  const ok = kapData.filter(d => d.mulig);

  const W=900, H=372, ml=74, mr=152, mt=20, mb=42;
  const plotEl = document.getElementById("plotKap");

  if(!ok.length){
    const trengs = info.kost - 0.90*info.V0;
    plotEl.innerHTML = '<div style="padding:44px 20px; color:var(--ink-2); font-size:14px; max-width:60ch">'
      + esc(L("Med " + kr(K) + " rekker det ikke til denne boligen i det hele tatt. Selv på 90 % belåning kreves "
              + kr(Math.max(0,trengs)) + " i egenkapital — " + kr(Math.max(0,trengs-K)) + " mer enn du har.",
              "At " + kr(K) + " this flat is out of reach entirely. Even at 90 % leverage it needs "
              + kr(Math.max(0,trengs)) + " of equity — " + kr(Math.max(0,trengs-K)) + " more than you have."))
      + '</div>';
    document.getElementById("legKap").innerHTML = "";
    document.getElementById("kapRad").innerHTML = "";
    document.getElementById("tblKap").innerHTML = "";
    document.getElementById("kapNote").textContent = L("Egenkapital ","Capital ") + kr(K);
    document.getElementById("kapFot").textContent = "";
    return;
  }

  const naa  = kapData.reduce((b,d)=>Math.abs(d.b-S.ltv)<Math.abs(b.b-S.ltv)?d:b, kapData[0]);
  const ref  = naa.mulig ? naa : ok[0];          // fondssporet må leses av et mulig punkt
  const best = ok.reduce((b,d)=>d.bolig>b.bolig?d:b, ok[0]);
  const dNaa = naa.bolig - uten, dBest = best.bolig - uten;

  const alle = ok.map(d => d.bolig).concat([uten]);
  // aksen starter ved kapitalen du la inn, ikke på null — ellers ligger kurvene
  // klemt sammen i overkant med tomrom under seg
  let lo = Math.min(K, ...alle), hi = Math.max(...alle);
  const spenn = (hi - lo) || 1; hi += spenn*0.10; lo -= spenn*0.13;
  const X = b => ml + (b/90)*(W-ml-mr);
  const Y = v => mt + (1-(v-lo)/(hi-lo))*(H-mt-mb);

  let g = "";
  niceTicks(lo,hi,5).forEach(v=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
    g += '<text x="'+(ml-10)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+mkr(v)+'</text>';
  });
  if(lo<0) g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(0).toFixed(1)+'" y2="'+Y(0).toFixed(1)+'" stroke="var(--axis)"/>';
  xs.filter(b=>b%15===0).forEach(b=>{
    g += '<text x="'+X(b).toFixed(1)+'" y="'+(H-mb+20)+'" text-anchor="middle" '+AX+'>'+b+' %</text>';
  });
  g += '<text x="'+((ml+W-mr)/2)+'" y="'+(H-4)+'" text-anchor="middle" '+AXL+'>'+L('Belåningsgrad','Loan-to-value')+'</text>';
  g += '<text transform="translate(15,'+((mt+H-mb)/2)+') rotate(-90)" text-anchor="middle" '+AXL+'>'
     + L('Formue etter '+N+' år','Wealth after '+N+' years')+'</text>';

  // skravert: her rekker ikke egenkapitalen til
  if(info.ltvMin > 0.5){
    const xc = X(Math.min(90, info.ltvMin));
    g += '<rect x="'+ml+'" y="'+mt+'" width="'+(xc-ml).toFixed(1)+'" height="'+(H-mt-mb)+'" fill="var(--ink-3)" opacity=".08"/>';
    g += '<line x1="'+xc.toFixed(1)+'" x2="'+xc.toFixed(1)+'" y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--ink-3)" stroke-width="1" stroke-dasharray="3 3" opacity=".7"/>';
    if(xc - ml > 130)
      g += '<text x="'+(xc-9).toFixed(1)+'" y="'+((mt+H-mb)/2).toFixed(1)+'" text-anchor="end" '+AX+'>'
         + esc(L('for lite egenkapital','not enough equity'))+'</text>';
  }

  // aksen begynner ikke på null, så det må stå hvor gulvet er: alt over denne
  // streken er avkastning på kapitalen
  if(K > lo && K < hi){
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(K).toFixed(1)+'" y2="'+Y(K).toFixed(1)
       + '" stroke="var(--ink-3)" stroke-width="1.5" opacity=".55" stroke-dasharray="4 3"/>';
    g += '<text x="'+(ml+8)+'" y="'+(Y(K)-7).toFixed(1)+'" '+AX+' fill="var(--ink-2)">'
       + esc(L('Innskutt kapital · ','Capital invested · ')+kr(K))+'</text>';
  }

  // markør for valgt belåningsgrad
  g += '<line x1="'+X(S.ltv).toFixed(1)+'" x2="'+X(S.ltv).toFixed(1)+'" y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--accent)" stroke-width="1.5" opacity=".35"/>';

  // gapet mellom sporene, i fargen til den som vinner ved den valgte belåningen
  g += '<path d="' + ok.map((d,i)=>(i?"L":"M")+X(d.b).toFixed(1)+" "+Y(d.bolig).toFixed(1)).join(" ")
    + " L"+X(ok[ok.length-1].b).toFixed(1)+" "+Y(uten).toFixed(1)+" L"+X(ok[0].b).toFixed(1)+" "+Y(uten).toFixed(1)
    + ' Z" fill="' + ((ref.bolig - uten) >= 0 ? "var(--s1)" : "var(--s2)") + '" opacity=".10"/>';

  // fondet bryr seg ikke om belåningsgraden — linja er vannrett over hele aksen
  g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(uten).toFixed(1)+'" y2="'+Y(uten).toFixed(1)
     + '" stroke="var(--s2)" stroke-width="2" stroke-linecap="round"/>';
  g += '<path d="' + ok.map((d,i)=>(i?"L":"M")+X(d.b).toFixed(1)+" "+Y(d.bolig).toFixed(1)).join(" ")
    + '" fill="none" stroke="var(--s1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';

  const sist = ok[ok.length-1];
  g += '<circle cx="'+X(sist.b).toFixed(1)+'" cy="'+Y(sist.bolig).toFixed(1)+'" r="4.5" fill="var(--s1)" stroke="var(--surface)" stroke-width="2"/>';
  g += '<circle cx="'+(W-mr).toFixed(1)+'" cy="'+Y(uten).toFixed(1)+'" r="4.5" fill="var(--s2)" stroke="var(--surface)" stroke-width="2"/>';
  const ends = [{y:Y(sist.bolig), n:L("Bolig + rest i fond","Flat + rest in fund"), c:"var(--s1)", v:sist.bolig},
                {y:Y(uten),       n:L("Kjøper ikke bolig","No flat bought"),        c:"var(--s2)", v:uten}].sort((a,b)=>a.y-b.y);
  if(ends[1].y - ends[0].y < 17) ends[1].y = ends[0].y + 17;
  ends.forEach(e=>{
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y-3).toFixed(1)+'" fill="'+e.c+'" font-family="var(--sans)" font-size="11.5" font-weight="600">'+esc(e.n)+'</text>';
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y+10).toFixed(1)+'" '+AX+'>'+mkr(e.v)+'</text>';
  });
  g += '<g id="kapCross" opacity="0"><line y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--ink-3)" stroke-width="1"/></g>';

  const svg = setSvg("plotKap","tipKap",g,W,H);
  const plot = document.getElementById("plotKap"), tip = document.getElementById("tipKap");
  const cg = svg.querySelector("#kapCross"), cl = cg.querySelector("line");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), sx = (ev.clientX-r.left)/r.width*W;
    if(sx<ml-6 || sx>W-mr+6){ hide(tip); cg.setAttribute("opacity",0); return; }
    const b = Math.round(Math.max(0,Math.min(90,(sx-ml)/(W-ml-mr)*90)));
    const d = kapData.find(x=>x.b===b); if(!d) return;
    cg.setAttribute("opacity",1); cl.setAttribute("x1",X(b)); cl.setAttribute("x2",X(b));
    const diff = d.bolig - uten;
    place(tip, plot, svg, W, X(b), mt+8,
      '<div class="t">'+L('Belåningsgrad ','Loan-to-value ')+b+' %</div>'
      + (d.mulig
          ? tipRow(L("Egenkapital i bolig","Equity in the flat"), kr(d.ek))
            + tipRow(L("Står i indeksfond","Left in the index fund"), kr(d.rest))
            + tipRow(L("Fylt på underveis","Topped up along the way"), kr(d.innskutt))
            + tipRow(L("Bolig + rest i fond","Flat + rest in fund"), krS(d.bolig), "var(--s1)")
            + tipRow(L("Kjøper ikke bolig","No flat bought"), krS(uten), "var(--s2)")
            + tipRow(L("Differanse","Difference"), (diff>=0?"+":"−")+kr(Math.abs(diff)))
            + tipRow(L("Meravkastning","Excess return"), d.mer==null?"—":ppS(d.mer)+L(" per år"," per year"))
          : tipRow(L("Krever egenkapital","Equity required"), kr(d.ek))
            + tipRow(L("Du mangler","You are short"), kr(Math.max(0, d.ek - K)))));
  };
  plot.onpointerleave = () => { hide(tip); cg.setAttribute("opacity",0); };

  document.getElementById("legKap").innerHTML =
      '<span class="item"><span class="swatch" style="background:var(--s1)"></span>'+L('Bolig + resten i indeksfond','Flat + the rest in the index fund')+'</span>'
    + '<span class="item"><span class="swatch" style="background:var(--s2)"></span>'+L('Kjøper ikke bolig — hele beløpet i indeksfond','No flat bought — the whole amount in the index fund')+'</span>'
    + '<span class="item"><span class="swatch" style="background:var(--ink-3);opacity:.55"></span>'+L('Innskutt kapital — aksen starter her','Capital invested — the axis starts here')+'</span>'
    + '<span class="item" style="color:var(--ink-3)">'+L('Begge etter skatt ved salg · ','Both after tax on sale · ')+kr(K)+L(' i kapital',' of capital')+'</span>';

  // ── oppsummering: hva valget faktisk koster ──────────────────────────
  const lavest = ok[0];
  const tile = (k,v,cls,sub) => '<div class="h"><span class="k">'+esc(k)+'</span><span class="v'
    + (cls?" "+cls:"")+'">'+v+'</span><span class="s">'+sub+'</span></div>';
  document.getElementById("kapRad").innerHTML =
      tile(L("Kjøper ikke bolig","No flat bought"), mkr(uten), "",
           esc(kr(K)) + L(" i indeksfond i " + N + " år"," in the index fund for " + N + " years")
           + (utenAvk == null ? "" : " · " + esc(pct1(utenAvk)) + L(" per år"," per year")))
    + tile(L("Ved " + S.ltv + " % belåning","At " + S.ltv + " % leverage"),
           naa.mulig ? (dNaa>=0?"+":"−")+mkr(Math.abs(dNaa)) : "—",
           naa.mulig ? (dNaa>=0?"pos":"neg") : "",
           naa.mulig
             ? (naa.mer == null ? "" : "<b>" + esc(ppS(naa.mer)) + L(" per år</b> · "," per year</b> · "))
               + esc(kr(naa.ek)) + L(" i boligen · "," in the flat · ") + esc(kr(naa.rest)) + L(" i fond"," in the fund")
               + (naa.innskutt > 0 ? L(" · " + kr(naa.innskutt) + " fylt på underveis",
                                       " · " + kr(naa.innskutt) + " topped up along the way") : "")
             : L("egenkapitalen rekker ikke hit","your equity does not reach this far"))
    + tile(dBest >= 0 ? L("Best belåningsgrad","Best loan-to-value") : L("Minst tap mot fondet","Smallest gap to the fund"),
           best.b + " %", "",
           esc(mkr(best.bolig)) + " · " + (dBest>=0?"+":"−") + esc(mkr(Math.abs(dBest)))
           + (best.mer == null ? "" : " · " + esc(ppS(best.mer)) + L(" per år"," per year"))
           + L(" mot å la være"," against not buying"))
    + tile(info.ltvMin > 0.5 ? L("Laveste du får til","Lowest you can manage") : L("Kontantkjøp","Cash purchase"),
           lavest.b + " %", "",
           info.ltvMin > 0.5
             ? esc(kr(K)) + L(" rekker ikke lenger ned"," does not stretch below that")
             : L("boligen betalt uten lån","the flat paid for without a loan"));

  document.getElementById("kapNote").textContent =
    L("Egenkapital ","Capital ") + kr(K) + L(" · eiertid "," · holding period ") + N + L(" år"," years")
    + L(" · rente "," · rate ") + pct1(S.rente) + L(" · indeksfond "," · index fund ") + pct1(S.indeks);

  const kryss = ok.find((d,i)=> i>0 && Math.sign(d.bolig-uten) !== Math.sign(ok[i-1].bolig-uten));
  document.getElementById("kapFot").innerHTML = L(
    "Terskelkurvene over flytter seg ikke av dette: kravet til yield blir det samme enten den ubrukte "
    + "kapitalen står i fond eller ikke, fordi de samme kronene får den samme avkastningen i begge "
    + "alternativene."
    + (S.formue ? " (Med formuesskatt på flytter de seg litt, fordi den skatten må betales i kontanter.)" : "")
    + " Det som endrer seg er kronene — hvor mye du sitter igjen med, og hvor stor del av det som henger "
    + "på én bolig."
    + (kryss ? " Her snur regnestykket ved <b style=\"color:var(--ink)\">" + kryss.b + " % belåning</b>." : "")
    + (naa.mulig && naa.innskutt > 0
        ? " Merk at boligen krever <b style=\"color:var(--ink)\">" + kr(naa.innskutt) + "</b> fylt på fra "
          + "lønna gjennom eiertiden ved " + naa.b + " % belåning. Fondsalternativet krever ingenting, "
          + "så de kronene er penger boligkurven har fått og fondskurven ikke. Meravkastningen er regnet "
          + "som internrente, så innskuddene teller fra den dagen de går inn og blåser ikke opp prosenten."
        : "")
    + " Kurven sier ingenting om risiko: den høyeste belåningen er nesten alltid det høyeste tallet, og "
    + "samtidig den eneste måten å tape hele beløpet på.",
    "The threshold curves above do not move because of this: the yield requirement is the same whether "
    + "the unused capital sits in a fund or not, because the same kroner earn the same return in both options."
    + (S.formue ? " (With wealth tax on they shift slightly, because that tax has to be paid in cash.)" : "")
    + " What changes is the kroner — how much you end up with, and how much of it hangs on one flat."
    + (kryss ? " Here the arithmetic turns at <b style=\"color:var(--ink)\">" + kryss.b + " % leverage</b>." : "")
    + (naa.mulig && naa.innskutt > 0
        ? " Note that at " + naa.b + " % leverage the flat needs <b style=\"color:var(--ink)\">" + kr(naa.innskutt)
          + "</b> topped up out of your salary over the holding period. The fund option needs nothing, so "
          + "those kroner are money the flat curve has received and the fund curve has not. The excess return "
          + "is an internal rate of return, so the top-ups count from the day they go in and do not inflate it."
        : "")
    + " The curve says nothing about risk: the highest leverage is nearly always the highest number, and "
    + "at the same time the only way to lose the whole amount.");

  document.getElementById("tblKap").innerHTML = tableHtml(
    [L("Belåningsgrad","Loan-to-value"),L("Egenkapital i bolig","Equity in the flat"),L("I indeksfond","In the index fund"),
     L("Fylt på underveis","Topped up"),L("Bolig + fond","Flat + fund"),L("Kjøper ikke bolig","No flat bought"),
     L("Differanse","Difference"),L("Meravkastning","Excess return")],
    kapData.filter(d=>d.b%10===0).map(d=> d.mulig
      ? [d.b+" %", kr(d.ek), kr(d.rest), kr(d.innskutt), krS(d.bolig), krS(uten), krS(d.bolig-uten),
         d.mer==null?"—":ppS(d.mer)]
      : [d.b+" %", kr(d.ek), "—", "—", L("ikke mulig","not possible"), krS(uten), "—", "—"]));
}

/* ═══ 7. Graf 2 — dine 62 boliger ════════════════════════════════════════ */
function drawScatter(th){
  const W=900, H=408, ml=68, mr=150, mt=20, mb=44;
  const pts = BOLIGER.map(b=>({n:b[0], tot:b[1], leie:b[2], drift:b[3], y:boligYield(b)}));
  const xmin=1.4e6, xmax=1.9e7;
  const X = v => ml + (Math.log(Math.max(xmin,Math.min(xmax,v)))-Math.log(xmin))/(Math.log(xmax)-Math.log(xmin))*(W-ml-mr);
  const ys = pts.map(p=>p.y).concat([th.indeks, th.cf].filter(v=>v!=null));
  let lo=Math.min(0,...ys), hi=Math.max(...ys); const pad=(hi-lo)*0.10; lo-=pad; hi+=pad;
  const Y = v => mt + (1-(v-lo)/(hi-lo))*(H-mt-mb);

  let g="";
  niceTicks(lo,hi,5).forEach(v=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
    g += '<text x="'+(ml-10)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+pct1(v)+'</text>';
  });
  [2e6,3e6,5e6,8e6,1.2e7,1.8e7].forEach(v=>{
    g += '<text x="'+X(v).toFixed(1)+'" y="'+(H-mb+20)+'" text-anchor="middle" '+AX+'>'+(v/1e6).toString().replace(".",",")+' mill.</text>';
  });
  g += '<text x="'+((ml+W-mr)/2)+'" y="'+(H-4)+'" text-anchor="middle" '+AXL+'>'+L('Totalpris (logaritmisk)','Total price (log scale)')+'</text>';
  g += '<text transform="translate(15,'+((mt+H-mb)/2)+') rotate(-90)" text-anchor="middle" '+AXL+'>'+L('Netto yield','Net yield')+'</text>';

  const rules = [];
  if(th.indeks!=null) rules.push({v:th.indeks, c:"var(--s1)", n:L("Slå indeksfondet","Beat the index fund")});
  if(th.cf!=null)     rules.push({v:th.cf,     c:"var(--s2)", n:L("Null kontantstrøm","Break-even cash flow")});
  rules.forEach(r=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(r.v).toFixed(1)+'" y2="'+Y(r.v).toFixed(1)+'" stroke="'+r.c+'" stroke-width="2"/>';
  });
  const sorted = rules.slice().sort((a,b)=>Y(a.v)-Y(b.v));
  for(let i=1;i<sorted.length;i++) if(Y(sorted[i].v)-Y(sorted[i-1].v)<26) sorted[i]._off=26-(Y(sorted[i].v)-Y(sorted[i-1].v));
  sorted.forEach(r=>{
    const yy = Y(r.v)+(r._off||0);
    g += '<text x="'+(W-mr+9)+'" y="'+(yy-3).toFixed(1)+'" fill="'+r.c+'" font-family="var(--sans)" font-size="11.5" font-weight="600">'+esc(r.n)+'</text>';
    g += '<text x="'+(W-mr+9)+'" y="'+(yy+10).toFixed(1)+'" '+AX+'>'+pct1(r.v)+'</text>';
  });

  const cut = th.indeks==null ? -1e9 : th.indeks;
  pts.forEach(p=>{
    p.px=X(p.tot); p.py=Y(p.y); p.ok = p.y>=cut;
    g += '<circle cx="'+p.px.toFixed(1)+'" cy="'+p.py.toFixed(1)+'" r="5" fill="'+(p.ok?"var(--good)":"var(--crit)")
       + '" fill-opacity=".85" stroke="var(--surface)" stroke-width="2"/>';
  });
  if(picked >= 0 && pts[picked]){
    const sp = pts[picked];
    g += '<circle cx="'+sp.px.toFixed(1)+'" cy="'+sp.py.toFixed(1)+'" r="10" fill="none" stroke="var(--ink)" stroke-width="1.5"/>';
    g += '<text x="'+sp.px.toFixed(1)+'" y="'+(sp.py-16).toFixed(1)+'" text-anchor="middle" fill="var(--ink)" font-family="var(--sans)" font-size="11.5" font-weight="600">'+esc(sp.n)+'</text>';
  }
  g += '<circle id="scatHi" r="9" fill="none" stroke="var(--ink)" stroke-width="1.5" opacity="0"/>';

  const svg = setSvg("plotScat","tipScat",g,W,H);
  const plot = document.getElementById("plotScat"), tip = document.getElementById("tipScat");
  const hi2 = svg.querySelector("#scatHi");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), k=r.width/W;
    const sx=(ev.clientX-r.left)/k, sy=(ev.clientY-r.top)/k;
    let best=null, bd=1e9;
    pts.forEach(p=>{ const d=(p.px-sx)**2+(p.py-sy)**2; if(d<bd){bd=d;best=p;} });
    if(!best || bd>26*26){ hide(tip); hi2.setAttribute("opacity",0); return; }
    hi2.setAttribute("cx",best.px); hi2.setAttribute("cy",best.py); hi2.setAttribute("opacity",1);
    place(tip, plot, svg, W, best.px, best.py,
      '<div class="t">'+esc(best.n)+'</div>'
      + tipRow(L("Netto yield","Net yield"), pct2(best.y), best.ok?"var(--good)":"var(--crit)")
      + tipRow(L("Brutto yield","Gross yield"), pct2(best.leie*12/best.tot*100))
      + tipRow(L("Totalpris","Total price"), kr(best.tot))
      + tipRow(L("Leie","Rent"), kr(best.leie)+L("/mnd","/mo"))
      + tipRow(L("Drift","Running costs"), kr(best.drift)+L("/mnd","/mo")));
  };
  plot.onpointerleave = () => { hide(tip); hi2.setAttribute("opacity",0); };

  const over = pts.filter(p=>p.ok).length;
  const overCf = th.cf==null?0:pts.filter(p=>p.y>=th.cf).length;
  document.getElementById("legScat").innerHTML =
      '<span class="item"><span class="dot" style="background:var(--good)"></span><span class="sym">✓</span> '+L('Slår indeksfondet','Beats the index fund')+' ('+over+L(' av ',' of ')+pts.length+')</span>'
    + '<span class="item"><span class="dot" style="background:var(--crit)"></span><span class="sym">✕</span> '+L('Taper mot indeksfondet','Loses to the index fund')+' ('+(pts.length-over)+')</span>';
  document.getElementById("scatNote").textContent =
    overCf + L(" av "," of ") + pts.length + L(" betaler sine egne avdrag"," pay their own principal");
  document.getElementById("tblScat").innerHTML = tableHtml(
    [L("Adresse","Address"),L("Totalpris","Total price"),L("Leie/mnd","Rent/mo"),L("Drift/mnd","Costs/mo"),L("Brutto yield","Gross yield"),L("Netto yield","Net yield"),L("Mot indeks","vs index")],
    pts.slice().sort((a,b)=>b.y-a.y).map(p=>[esc(p.n), kr(p.tot), kr(p.leie), kr(p.drift),
      pct2(p.leie*12/p.tot*100), pct2(p.y), p.ok?L("✓ over","✓ above"):L("✕ under","✕ below")]));
}
</script>

<script is:inline>
"use strict";
/* ═══ 8. Graf 3 — rente × verdistigning ══════════════════════════════════ */
function divFill(v, D){
  const w = Math.min(100, Math.abs(v)/D*100).toFixed(1);
  const pole = v>=0 ? "var(--div-pos)" : "var(--div-neg)";
  return "color-mix(in srgb, "+pole+" "+w+"%, var(--div-mid))";
}
function drawHeat(){
  const W=900, H=430, ml=74, mr=132, mt=22, mb=48;
  const renter=[], vekst=[];
  for(let r=2; r<=8.001; r+=0.5) renter.push(+r.toFixed(1));
  for(let g=0; g<=6.001; g+=0.5) vekst.push(+g.toFixed(1));
  const N = Math.round(S.horisont);
  const cells = [];
  vekst.forEach(g => renter.forEach(r => {
    const s = simuler({rente:r, vekstbolig:g});
    const a = s.siste; let v;
    if(!a || a.fondNetto<=0) v = 0;
    else if(a.bolig<=0) v = -99;
    else v = (Math.pow(a.bolig/a.fondNetto, 1/N)-1)*100;
    cells.push({r, g, v});
  }));
  const finite = cells.map(c=>c.v).filter(v=>v>-90);
  const D = Math.max(1, Math.min(12, Math.max(...finite.map(Math.abs))));
  const cw = (W-ml-mr)/renter.length, ch = (H-mt-mb)/vekst.length;
  const X = i => ml + i*cw, Y = j => mt + (vekst.length-1-j)*ch;

  let out="";
  cells.forEach(c=>{
    const i = renter.indexOf(c.r), j = vekst.indexOf(c.g);
    const fill = c.v<=-90 ? "var(--div-neg)" : divFill(c.v, D);
    out += '<rect x="'+(X(i)+1).toFixed(1)+'" y="'+(Y(j)+1).toFixed(1)+'" width="'+(cw-2).toFixed(1)
        +'" height="'+(ch-2).toFixed(1)+'" rx="2" fill="'+fill+'" data-i="'+i+'" data-j="'+j+'"/>';
  });
  renter.forEach((r,i)=>{ if(i%2===0) out += '<text x="'+(X(i)+cw/2).toFixed(1)+'" y="'+(H-mb+19)+'" text-anchor="middle" '+AX+'>'+nf1.format(r)+'</text>'; });
  vekst.forEach((g,j)=>{ if(j%2===0) out += '<text x="'+(ml-10)+'" y="'+(Y(j)+ch/2+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+nf1.format(g)+' %</text>'; });
  out += '<text x="'+((ml+W-mr)/2)+'" y="'+(H-6)+'" text-anchor="middle" '+AXL+'>'+L('Lånerente, prosent','Loan interest rate, per cent')+'</text>';
  out += '<text transform="translate(16,'+((mt+H-mb)/2)+') rotate(-90)" text-anchor="middle" '+AXL+'>'+L('Verdistigning bolig','Property appreciation')+'</text>';

  // markør for gjeldende innstilling
  const ci = renter.reduce((b,r,i)=>Math.abs(r-S.rente)<Math.abs(renter[b]-S.rente)?i:b,0);
  const cj = vekst.reduce((b,g,j)=>Math.abs(g-S.vekstbolig)<Math.abs(vekst[b]-S.vekstbolig)?j:b,0);
  out += '<rect x="'+(X(ci)+1).toFixed(1)+'" y="'+(Y(cj)+1).toFixed(1)+'" width="'+(cw-2).toFixed(1)
      +'" height="'+(ch-2).toFixed(1)+'" rx="2" fill="none" stroke="var(--ink)" stroke-width="2"/>';
  out += '<text x="'+(X(ci)+cw/2).toFixed(1)+'" y="'+(Y(cj)-5).toFixed(1)+'" text-anchor="middle" fill="var(--ink)" font-family="var(--sans)" font-size="11" font-weight="600">'+L('nå','now')+'</text>';

  // skalalegende
  const lx=W-mr+22, ly=mt+8, lh=H-mt-mb-30, lw=13;
  out += '<defs><linearGradient id="divgrad" x1="0" y1="0" x2="0" y2="1">'
      + '<stop offset="0%" stop-color="'+divFill(D,D)+'"/><stop offset="50%" stop-color="var(--div-mid)"/>'
      + '<stop offset="100%" stop-color="'+divFill(-D,D)+'"/></linearGradient></defs>';
  out += '<rect x="'+lx+'" y="'+ly+'" width="'+lw+'" height="'+lh+'" rx="3" fill="url(#divgrad)" stroke="var(--ring)"/>';
  [[0,"+"+nf1.format(D)+" pp"],[0.5,"0"],[1,"−"+nf1.format(D)+" pp"]].forEach(([f,t])=>{
    out += '<text x="'+(lx+lw+7)+'" y="'+(ly+f*lh+4).toFixed(1)+'" '+AX+'>'+t+'</text>';
  });
  out += '<text x="'+lx+'" y="'+(ly+lh+22)+'" '+AX+' fill="var(--ink-2)">'+L('bolig − fond','flat − fund')+'</text>';

  const svg = setSvg("plotHeat","tipHeat",out,W,H);
  const plot = document.getElementById("plotHeat"), tip = document.getElementById("tipHeat");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), k=r.width/W;
    const sx=(ev.clientX-r.left)/k, sy=(ev.clientY-r.top)/k;
    const i = Math.floor((sx-ml)/cw), j = vekst.length-1-Math.floor((sy-mt)/ch);
    if(i<0||i>=renter.length||j<0||j>=vekst.length){ hide(tip); return; }
    const c = cells.find(c=>c.r===renter[i] && c.g===vekst[j]); if(!c) return;
    place(tip, plot, svg, W, X(i)+cw/2, Y(j),
      '<div class="t">'+L('Rente ','Rate ')+pct1(renter[i])+L(' · vekst ',' · growth ')+pct1(vekst[j])+'</div>'
      + tipRow(L("Meravkastning","Excess return"), c.v<=-90 ? L("egenkapitalen tapt","equity wiped out") : ppS(c.v)+L(" per år"," per year"))
      + tipRow(L("Konklusjon","Verdict"), c.v>0?L("boligen vinner","the flat wins"):L("fondet vinner","the fund wins")));
  };
  plot.onpointerleave = () => hide(tip);

  document.getElementById("legHeat").innerHTML =
      '<span class="item"><span class="dot" style="background:var(--div-pos)"></span>'+L('Boligen gir mer','The flat gives more')+'</span>'
    + '<span class="item"><span class="dot" style="background:var(--div-mid);box-shadow:0 0 0 1px var(--line-2)"></span>'+L('Likt','Equal')+'</span>'
    + '<span class="item"><span class="dot" style="background:var(--div-neg)"></span>'+L('Indeksfondet gir mer','The index fund gives more')+'</span>'
    + '<span class="item" style="color:var(--ink-3)">'+L('Belåning ','Leverage ')+S.ltv+' % · '+N+L(' års eiertid · netto yield ',' year hold · net yield ')+pct1(simuler({}).nettoYield)+'</span>';
  document.getElementById("tblHeat").innerHTML = tableHtml(
    [L("Verdistigning","Appreciation")].concat(renter.map(r=>nf1.format(r)+" %")),
    vekst.slice().reverse().map(g=>[nf1.format(g)+" %"].concat(renter.map(r=>{
      const c=cells.find(c=>c.r===r&&c.g===g); return c.v<=-90?"—":ppS(c.v); }))));
}

/* ═══ 9. Graf 4 — formue over tid ════════════════════════════════════════ */
function drawWealth(sim){
  const W=900, H=372, ml=66, mr=142, mt=20, mb=42;
  const N = sim.aar.length;
  const b = [{t:0,v:sim.KAP}].concat(sim.aar.map(a=>({t:a.t, v:a.bolig})));
  const f = [{t:0,v:sim.KAP}].concat(sim.aar.map(a=>({t:a.t, v:a.fondNetto})));
  const inn = [{t:0,v:sim.KAP}].concat(sim.aar.map(a=>({t:a.t, v:a.innskuttSum})));
  const all = b.concat(f, inn).map(d=>d.v);
  let lo=Math.min(0,...all), hi=Math.max(...all); const pad=(hi-lo)*0.10; hi+=pad; lo-=pad*0.4;
  const X = t => ml + (t/N)*(W-ml-mr);
  const Y = v => mt + (1-(v-lo)/(hi-lo))*(H-mt-mb);

  let g="";
  niceTicks(lo,hi,5).forEach(v=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
    g += '<text x="'+(ml-10)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+mkr(v)+'</text>';
  });
  if(lo<0) g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(0).toFixed(1)+'" y2="'+Y(0).toFixed(1)+'" stroke="var(--axis)"/>';
  const step = N<=10?2:N<=20?4:5;
  const ticks=[]; for(let t=0;t<=N;t+=step) ticks.push(t);
  if(N-ticks[ticks.length-1] < step*0.5) ticks.pop();
  ticks.push(N);
  ticks.forEach(t => g += '<text x="'+X(t).toFixed(1)+'" y="'+(H-mb+20)+'" text-anchor="middle" '+AX+'>'+t+'</text>');
  g += '<text x="'+((ml+W-mr)/2)+'" y="'+(H-4)+'" text-anchor="middle" '+AXL+'>'+L('År etter kjøp','Years after purchase')+'</text>';

  const line = (arr,c,w,op) => '<path d="'+arr.map((d,i)=>(i?"L":"M")+X(d.t).toFixed(1)+" "+Y(d.v).toFixed(1)).join(" ")
      + '" fill="none" stroke="'+c+'" stroke-width="'+w+'" stroke-linejoin="round" stroke-linecap="round"'+(op?' opacity="'+op+'"':'')+'/>';
  g += line(inn,"var(--ink-3)",1.5,".6");
  g += line(f,"var(--s2)",2);
  g += line(b,"var(--s1)",2);
  [[b,"var(--s1)","Bolig"],[f,"var(--s2)","Indeksfond"]].forEach(([arr,c])=>{
    const l=arr[arr.length-1];
    g += '<circle cx="'+X(l.t).toFixed(1)+'" cy="'+Y(l.v).toFixed(1)+'" r="4.5" fill="'+c+'" stroke="var(--surface)" stroke-width="2"/>';
  });
  const ends=[{y:Y(b[b.length-1].v),n:L("Bolig","Flat"),c:"var(--s1)",v:b[b.length-1].v},
              {y:Y(f[f.length-1].v),n:L("Indeksfond","Index fund"),c:"var(--s2)",v:f[f.length-1].v},
              {y:Y(inn[inn.length-1].v),n:L("Innskutt","Invested"),c:"var(--ink-3)",v:inn[inn.length-1].v}].sort((a,c)=>a.y-c.y);
  for(let i=1;i<ends.length;i++) if(ends[i].y-ends[i-1].y<17) ends[i].y=ends[i-1].y+17;
  ends.forEach(e=>{
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y-3).toFixed(1)+'" fill="'+e.c+'" font-family="var(--sans)" font-size="11.5" font-weight="600">'+e.n+'</text>';
    g += '<text x="'+(W-mr+9)+'" y="'+(e.y+10).toFixed(1)+'" '+AX+'>'+mkr(e.v)+'</text>';
  });
  g += '<g id="wCross" opacity="0"><line y1="'+mt+'" y2="'+(H-mb)+'" stroke="var(--ink-3)" stroke-width="1"/></g>';

  const svg = setSvg("plotWealth","tipWealth",g,W,H);
  const plot = document.getElementById("plotWealth"), tip = document.getElementById("tipWealth");
  const cg = svg.querySelector("#wCross"), cl = cg.querySelector("line");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), sx=(ev.clientX-r.left)/r.width*W;
    if(sx<ml-6||sx>W-mr+6){ hide(tip); cg.setAttribute("opacity",0); return; }
    const t = Math.max(0,Math.min(N,Math.round((sx-ml)/(W-ml-mr)*N)));
    cg.setAttribute("opacity",1); cl.setAttribute("x1",X(t)); cl.setAttribute("x2",X(t));
    const d = b[t].v - f[t].v;
    place(tip, plot, svg, W, X(t), mt+8,
      '<div class="t">'+(t===0?L("Ved kjøp","At purchase"):L("Etter "+t+" år","After "+t+" years"))+'</div>'
      + tipRow(L("Bolig","Flat"), krS(b[t].v), "var(--s1)")
      + tipRow(L("Indeksfond","Index fund"), krS(f[t].v), "var(--s2)")
      + tipRow(L("Innskutt kapital","Capital invested"), krS(inn[t].v), "var(--ink-3)")
      + tipRow(L("Differanse","Difference"), (d>=0?"+":"−")+kr(Math.abs(d))));
  };
  plot.onpointerleave = () => { hide(tip); cg.setAttribute("opacity",0); };

  document.getElementById("legWealth").innerHTML =
      '<span class="item"><span class="swatch" style="background:var(--s1)"></span>'+L('Bolig, etter skatt ved salg','Flat, after tax on sale')+'</span>'
    + '<span class="item"><span class="swatch" style="background:var(--s2)"></span>'+L('Indeksfond, etter skatt','Index fund, after tax')+'</span>'
    + '<span class="item"><span class="swatch" style="background:var(--ink-3);opacity:.6"></span>'+L('Innskutt kapital','Capital invested')+'</span>';
  // 1, 3, 5 og 10 år — samme horisonter som i regnearket
  const hz = [1,3,5,10].filter(y => y <= N);
  document.getElementById("horisontRad").innerHTML = hz.map(y => {
    const d = b[y].v - f[y].v;
    return '<div class="h"><span class="k">' + L("Etter " + y + " år", "After " + y + " year" + (y>1?"s":""))
      + '</span><span class="v ' + (d>=0?"pos":"neg") + '">' + (d>=0?"+":"−") + mkr(Math.abs(d))
      + '</span><span class="s">' + L("bolig ","flat ") + mkr(b[y].v) + L(" mot fond "," vs fund ") + mkr(f[y].v)
      + '</span></div>';
  }).join("");

  document.getElementById("wealthNote").textContent = sim.rest > 0
    ? L("Kapital ved start ","Capital at the start ") + kr(sim.KAP) + L(" · derav "," · of which ") + kr(sim.EK)
      + L(" i boligen og "," in the flat and ") + kr(sim.rest) + L(" i indeksfond · lån "," in the index fund · loan ") + kr(sim.laan0)
    : L("Egenkapital ved kjøp ","Equity at purchase ") + kr(sim.EK) + L(" · lån "," · loan ") + kr(sim.laan0);
  document.getElementById("tblWealth").innerHTML = tableHtml(
    [L("År","Year"),L("Bolig","Flat"),L("Indeksfond","Index fund"),L("Differanse","Difference"),L("Innskutt","Invested"),L("Boligverdi","Property value"),L("Restgjeld","Debt left")],
    b.map((d,i)=>[d.t, krS(d.v), krS(f[i].v), krS(d.v-f[i].v), krS(inn[i].v),
      i===0?kr(sim.V0):kr(sim.aar[i-1].V), i===0?kr(sim.laan0):kr(sim.aar[i-1].gjeld)]));
}

/* ═══ 10. Graf 5 — kontantstrømmen måned én ══════════════════════════════ */
function drawFall(sim){
  const a = sim.aar[0]; if(!a) return;
  const p = sim.p;
  const steps = [
    {n:L("Brutto leie","Gross rent"),        v: p.leie,                          start:true},
    {n:L("Ledighet","Vacancy"),           v: -p.leie*(p.ledig/100)},
    {n:L("Drift og vedlikehold","Costs and maintenance"), v: -(p.drift + p.vedl/100*sim.V0/12)},
    {n:L("Renter","Interest"),             v: -a.rente/12},
    {n:L("Avdrag","Principal"),             v: -a.avdr/12},
    {n:L("Skatt","Tax"),              v: -a.skattLeie/12}
  ];
  if(p.formue) steps.push({n:L("Formuesskatt","Wealth tax"), v:-a.fBolig/12});

  const W=900, H=308, ml=54, mr=24, mt=26, mb=64;
  const n = steps.length+1, bw = (W-ml-mr)/n*0.62, gapw=(W-ml-mr)/n;
  let run=0; const bars=[];
  steps.forEach((s,i)=>{ const from=run; run+=s.v; bars.push({n:s.n, from, to:run, v:s.v, i}); });
  const total = run;
  bars.push({n:L("Kontantstrøm","Cash flow"), from:0, to:total, v:total, i:steps.length, total:true});
  const vals = bars.flatMap(b=>[b.from,b.to]).concat([0]);
  let lo=Math.min(...vals), hi=Math.max(...vals); const pad=(hi-lo)*0.16; lo-=pad; hi+=pad;
  const Y = v => mt + (1-(v-lo)/(hi-lo))*(H-mt-mb);
  const Xc = i => ml + gapw*i + gapw/2;

  let g="";
  niceTicks(lo,hi,4).forEach(v=>{
    g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--grid)"/>';
    g += '<text x="'+(ml-10)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end" '+AX+'>'+mkr(v)+'</text>';
  });
  g += '<line x1="'+ml+'" x2="'+(W-mr)+'" y1="'+Y(0).toFixed(1)+'" y2="'+Y(0).toFixed(1)+'" stroke="var(--axis)"/>';

  bars.forEach((b,i)=>{
    const y0=Y(b.from), y1=Y(b.to), top=Math.min(y0,y1), h=Math.max(2,Math.abs(y1-y0));
    const fill = b.total ? (b.v>=0?"var(--good)":"var(--crit)") : (i===0?"var(--s1)":"var(--ink-3)");
    g += '<rect x="'+(Xc(i)-bw/2).toFixed(1)+'" y="'+top.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+h.toFixed(1)
      + '" rx="3" fill="'+fill+'" data-b="'+i+'"/>';
    if(i<bars.length-1 && !bars[i+1].total)
      g += '<line x1="'+(Xc(i)+bw/2).toFixed(1)+'" x2="'+(Xc(i+1)-bw/2).toFixed(1)+'" y1="'+y1.toFixed(1)+'" y2="'+y1.toFixed(1)+'" stroke="var(--line-2)" stroke-width="1"/>';
    const lab = Math.min(y0,y1)-8;
    g += '<text x="'+Xc(i).toFixed(1)+'" y="'+lab.toFixed(1)+'" text-anchor="middle" font-family="var(--mono)" font-size="11" font-weight="500" fill="'
      + (b.total ? (b.v>=0?"var(--good)":"var(--crit)") : "var(--ink-2)") + '">'+(b.total?krS(b.v):(b.v>=0?"+":"−")+nf0.format(Math.abs(Math.round(b.v))))+'</text>';
    const words = b.n.split(" ");
    if(words.length>2){
      g += '<text x="'+Xc(i).toFixed(1)+'" y="'+(H-mb+18)+'" text-anchor="middle" '+AXL+'>'+esc(words.slice(0,2).join(" "))+'</text>';
      g += '<text x="'+Xc(i).toFixed(1)+'" y="'+(H-mb+32)+'" text-anchor="middle" '+AXL+'>'+esc(words.slice(2).join(" "))+'</text>';
    } else {
      g += '<text x="'+Xc(i).toFixed(1)+'" y="'+(H-mb+18)+'" text-anchor="middle" '+AXL+'>'+esc(b.n)+'</text>';
    }
  });

  const svg = setSvg("plotFall","tipFall",g,W,H);
  const plot = document.getElementById("plotFall"), tip = document.getElementById("tipFall");
  plot.onpointermove = ev => {
    const r = svg.getBoundingClientRect(), sx=(ev.clientX-r.left)/r.width*W;
    const i = Math.floor((sx-ml)/gapw);
    if(i<0||i>=bars.length){ hide(tip); return; }
    const b = bars[i];
    place(tip, plot, svg, W, Xc(i), Math.min(Y(b.from),Y(b.to)),
      '<div class="t">'+esc(b.n)+'</div>'
      + tipRow(b.total?L("Netto per måned","Net per month"):L("Endring","Change"), krS(b.v))
      + (b.total?"":tipRow(L("Igjen etter dette","Left after this"), krS(b.to))));
  };
  plot.onpointerleave = () => hide(tip);

  document.getElementById("tblFall").innerHTML = tableHtml(
    [L("Post","Item"),L("Per måned","Per month"),L("Per år","Per year"),L("Løpende","Running")],
    bars.map(b=>[esc(b.n), krS(b.v), krS(b.v*12), krS(b.to)]));
}
</script>

<script is:inline>
"use strict";
/* ═══ 11. Kontroller og oppdatering ══════════════════════════════════════ */
const $ = id => document.getElementById(id);
const FMT = {
  pris:kr, opp:kr, leie:v=>kr(v)+"/mnd", drift:v=>kr(v)+"/mnd",
  ledig:pct1, vedl:pct1, ltv:v=>nf0.format(v)+" %", rente:pct1, ektot:kr,
  lopetid:v=>v+" år", vekstbolig:pct1, indeks:pct1, kpi:pct1,
  horisont:v=>v+" år", salgsomk:pct1, formuesats:pct2, driftandel:pct1
};
/* beløpssnarveiene: faste summer, pluss «hele kjøpesummen» som følger boligen */
function ekChip(c){
  const raw = c.dataset.ek === "kost" ? kapitalOppsett().kost : parseFloat(c.dataset.ek);
  const el = $("ektot");
  return Math.min(parseFloat(el.max), Math.max(parseFloat(el.min), Math.round(raw/50000)*50000));
}
const RANGES = ["pris","opp","leie","drift","ledig","vedl","ltv","rente","lopetid","ektot",
                "vekstbolig","indeks","kpi","horisont","salgsomk","formuesats","driftandel"];
const TOGGLES = ["dokavg","avdragsfri","skatt","formue","restfond"];
let picked = -1;

/* ═══ Tallfeltene ════════════════════════════════════════════════════════
   Hver skyver har et felt du kan klikke i og skrive tallet rett inn i.
   Feltet viser det formaterte tallet («2 080 000 kr», «8,0 %»), så det
   formatet må også kunne leses tilbake igjen. */
/* monospace: én ch er nøyaktig ett tegn, så feltet blir like bredt som tallet */
const bredde = box => { box.style.width = "calc(" + Math.max(4, box.value.length) + "ch + 12px)"; };

function visTall(k){
  const box = $(k+"V");
  if(!box) return;
  if(box.tagName !== "INPUT"){ box.textContent = FMT[k](S[k]); return; }
  const lab = document.querySelector('label[for="'+k+'"]');
  if(lab) box.setAttribute("aria-label", lab.textContent.trim());
  if(document.activeElement === box) return;      // ikke overskriv det du skriver
  box.value = FMT[k](S[k]);
  bredde(box);
  box.classList.remove("bad");
}

/* I redigering vises tallet uten enhet og tusenskille — da slipper du å
   slette « kr» før du kan skrive. Ved blur formateres det tilbake. */
function raaTall(k){
  return String(S[k]).replace(".", LANG === "en" ? "." : ",");
}

function lesTall(txt){
  const t = String(txt).replace(/[\s  ]/g, "").replace(/[^0-9,.\-]/g, "");
  if(!t || t === "-") return null;
  let n;
  if(t.includes(",")) n = parseFloat(t.replace(/\./g, "").replace(",", "."));
  else {
    // «2.080.000» er tusenskille, «5.5» er desimaltall
    const d = t.split(".");
    n = (d.length > 2 || (d.length === 2 && d[1].length === 3)) ? parseFloat(t.replace(/\./g, "")) : parseFloat(t);
  }
  return isFinite(n) ? n : null;
}

/* Felt som vises eller brukes som hele tall må rundes til trinnet; kroner
   og prosent med desimaler får stå nøyaktig slik de er skrevet. */
const HELTALL = ["ltv","lopetid","horisont"];
function settTall(k, v, box){
  const r = $(k), steg = parseFloat(r.step) || 1;
  if(steg < 1 || HELTALL.includes(k)) v = Math.round(v/steg)*steg;
  v = Math.min(parseFloat(r.max), Math.max(parseFloat(r.min), v));
  v = +v.toFixed(6);
  S[k] = v;
  if(picked >= 0 && AVLEDET.includes(k)){ picked = -1; $("pick").value = "-1"; }
  if(box){ box.value = FMT[k](v); bredde(box); box.classList.remove("bad"); box.select(); }
  schedule();
}

function skrivTall(k, box){
  const n = lesTall(box.value);
  if(n === null){ box.classList.add("bad"); return false; }
  settTall(k, n, null);
  return true;
}

/* Tab hopper til neste tall, ikke til skyveren imellom. Skjulte felt
   (lukkede paneler, kapitalfeltet når bryteren er av) hoppes over. */
function nesteTallfelt(box, retning){
  const alle = [...document.querySelectorAll("input.val")].filter(e => e.offsetParent !== null);
  const i = alle.indexOf(box);
  if(i < 0) return;
  const neste = alle[(i + retning + alle.length) % alle.length];
  if(neste){ neste.focus(); neste.select(); }
}

function koblTallfelt(){
  RANGES.forEach(k => {
    const box = $(k+"V");
    if(!box || box.tagName !== "INPUT") return;
    box.addEventListener("focus", () => {
      box.value = raaTall(k);
      bredde(box);
      box.__velg = true;
      box.select();
    });
    // musetrykk kollapser markeringen fra focus — merk hele tallet på nytt
    box.addEventListener("mouseup", e => { if(box.__velg){ e.preventDefault(); box.select(); box.__velg = false; } });
    box.addEventListener("blur",  () => { box.__velg = false; if(!skrivTall(k, box)) visTall(k); });
    box.addEventListener("keydown", e => {
      if(e.key === "Enter" || e.key === "Tab"){
        e.preventDefault();
        if(skrivTall(k, box)) nesteTallfelt(box, e.shiftKey ? -1 : 1);
      } else if(e.key === "Escape"){
        e.preventDefault(); box.classList.remove("bad"); box.value = FMT[k](S[k]); box.select();
      } else if(e.key === "ArrowUp" || e.key === "ArrowDown"){
        e.preventDefault();
        const n = lesTall(box.value); if(n === null) return;
        const steg = parseFloat($(k).step) * (e.shiftKey ? 10 : 1);
        settTall(k, n + (e.key === "ArrowUp" ? steg : -steg), box);
      }
    });
  });
}

function syncInputs(){
  RANGES.forEach(k=>{ const el=$(k); if(!el) return; el.value = S[k]; visTall(k); });
  TOGGLES.forEach(k=>{ const el=$(k); if(el) el.checked = !!S[k]; });
  document.querySelectorAll(".chip[data-rente]").forEach(c=>
    c.setAttribute("aria-pressed", Math.abs(parseFloat(c.dataset.rente)-S.rente)<0.05));
  document.querySelectorAll(".chip[data-ek]").forEach(c=>
    c.setAttribute("aria-pressed", Math.abs(ekChip(c)-S.ektot) < 25000));
  const fn = $("fabNum");
  if(fn) fn.textContent = S.ltv + " % lån · " + pct1(S.rente);

  // fast egenkapital: feltet vises bare når bryteren står på, og forteller fordelingen
  const ekf = $("ektotField");
  if(ekf){
    ekf.hidden = !S.restfond;
    const i = kapitalOppsett();
    const naaLtv = Math.min(90, Math.ceil(i.ltvMin));
    const knapp = i.ltvMin <= 90
      ? ' <button type="button" class="chip" id="ektotFix" style="margin-top:5px">'
        + L("Sett belåningen til " + naaLtv + " %", "Set leverage to " + naaLtv + " %") + '</button>'
      : "";
    $("ektotHint").innerHTML = i.mangler > 0
      ? L("Boligen krever " + kr(i.EK) + " ved " + S.ltv + " % belåning — du mangler <b>" + kr(i.mangler)
          + "</b>. Regnestykket bruker det boligen faktisk krever." + knapp,
          "The flat needs " + kr(i.EK) + " at " + S.ltv + " % leverage — you are <b>" + kr(i.mangler)
          + "</b> short. The model uses what the flat actually requires." + knapp)
      : L(kr(i.EK) + " går inn i boligen, <b>" + kr(i.rest) + "</b> blir stående i indeksfond.",
          kr(i.EK) + " goes into the flat, <b>" + kr(i.rest) + "</b> stays in the index fund.");
  }
}

/* ═══ Tilstand i adressefeltet — hver innstilling kan deles som lenke ═════ */
const BOOLS = ["dokavg","avdragsfri","skatt","formue","restfond"];
const AVLEDET = ["pris","opp","leie","drift"];   // følger av valgt bolig

function writeUrl(){
  const q = new URLSearchParams();
  if(picked >= 0) q.set("bolig", String(picked));
  RANGES.forEach(k=>{
    if(picked >= 0 && AVLEDET.includes(k)) return;
    if(S[k] !== DEFAULTS[k]) q.set(k, String(S[k]));
  });
  BOOLS.forEach(k=>{ if(!!S[k] !== !!DEFAULTS[k]) q.set(k, S[k] ? "1" : "0"); });
  if(LANG !== "no") q.set("lang", LANG);
  if(SOV.some((r,i) => r.some((v,j) => v !== SOV_DEFAULT[i][j])))
    q.set("sov", SOV.map(r => r.join("-")).join("_"));
  const qs = q.toString();
  try{ history.replaceState(null, "", location.pathname + (qs ? "?"+qs : "") + location.hash); }catch(e){}
}

function readUrl(){
  let q; try{ q = new URLSearchParams(location.search); }catch(e){ return; }
  BOOLS.forEach(k=>{ if(q.has(k)) S[k] = q.get(k) === "1"; });
  const b = q.get("bolig");
  if(b !== null){
    const i = parseInt(b,10);
    if(i >= 0 && i < BOLIGER.length){
      picked = i;
      const bo = BOLIGER[i];
      S.pris  = Math.round(bo[1] / (S.dokavg ? 1.025 : 1) / 10000) * 10000;
      S.opp   = 0; S.leie = bo[2]; S.drift = bo[3];
    }
  }
  RANGES.forEach(k=>{
    if(!q.has(k)) return;
    const el = $(k), v = parseFloat(q.get(k));
    if(!isFinite(v) || !el) return;
    S[k] = Math.min(parseFloat(el.max), Math.max(parseFloat(el.min), v));
  });
  const sv = q.get("sov");
  if(sv){
    sv.split("_").slice(0,4).forEach((row,i) => {
      const t = row.split("-").map(Number);
      if(t.length === 3 && t.every(x => isFinite(x) && x >= 0)) SOV[i] = t;
    });
  }
}

